---
// PhotoGallerySection.astro - Dúo de Fotos y Carrusel de Recuerdos
import { asset } from '../utils/paths';

const samplePhoto = asset("/img/gabriel-tovar-RmIxQ05GzH0-unsplash.jpg");
const galleryItems = [
  { src: samplePhoto, caption: "Nuestros Momentos 1" },
  { src: samplePhoto, caption: "Nuestros Momentos 2" },
  { src: samplePhoto, caption: "Nuestros Momentos 3" },
  { src: samplePhoto, caption: "Nuestros Momentos 4" },
];
---

<section class="inv-section photo-gallery-section fade-in-on-scroll">
  <!-- Dúo de Fotos Superior -->
  <div class="photo-duo-grid">
    <div class="photo-card photo-card-arch">
      <img
        src={samplePhoto}
        alt="Recuerdos Roxana y Ruben"
        class="duo-img"
        loading="lazy"
      />
    </div>
    <div class="photo-card photo-card-arch">
      <img
        src={samplePhoto}
        alt="Recuerdos Roxana y Ruben"
        class="duo-img"
        loading="lazy"
      />
    </div>
  </div>

  <!-- Separador dorado -->
  <div class="gold-divider" style="margin: 22px auto;">
    <span class="gold-divider-dot"></span>
  </div>

  <!-- Título del Carrusel / Galería -->
  <div class="gallery-header">
    <span class="gallery-sub">NUESTRA HISTORIA</span>
    <h2 class="gallery-title">Galer&iacute;a de Fotos</h2>
  </div>

  <!-- Carrusel Touch / Mobile First -->
  <div class="carousel-container">
    <button class="carousel-btn prev-btn" id="galleryPrevBtn" aria-label="Foto anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="carousel-track" id="galleryTrack">
      {galleryItems.map((item, index) => (
        <div class="carousel-slide" data-index={index}>
          <img
            src={item.src}
            alt={item.caption}
            class="carousel-img"
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <button class="carousel-btn next-btn" id="galleryNextBtn" aria-label="Siguiente foto">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- Indicadores de puntos -->
  <div class="carousel-dots" id="galleryDots">
    {galleryItems.map((_, index) => (
      <span class={`carousel-dot ${index === 0 ? 'active' : ''}`} data-dot={index}></span>
    ))}
  </div>

  <p class="gallery-quote">
    &ldquo;Gracias por convertir los d&iacute;as comunes en recuerdos que quiero guardar para siempre.&rdquo;
  </p>
</section>

<style>
  .photo-gallery-section {
    padding-top: 15px;
    padding-bottom: 25px;
  }

  .photo-duo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    max-width: 420px;
    margin: 0 auto;
    padding: 0 10px;
  }

  .photo-card {
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(117, 123, 77, 0.18);
    border: 2px solid rgba(255, 255, 255, 0.85);
    background: #e8ebd8;
  }

  .photo-card-arch {
    border-radius: 60px 18px 18px 18px;
  }

  .photo-duo-grid .photo-card:nth-child(2) {
    border-radius: 18px 60px 18px 18px;
  }

  .duo-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }

  .gallery-header {
    margin-bottom: 14px;
    text-align: center;
  }

  .gallery-sub {
    display: block;
    font-family: var(--font-heading);
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--color-primary);
    font-weight: 700;
  }

  .gallery-title {
    font-family: var(--font-script);
    font-size: 44px;
    color: var(--color-primary);
    margin: 4px 0 0 0;
    line-height: 1.2;
    font-weight: normal;
  }

  /* Carousel */
  .carousel-container {
    position: relative;
    max-width: 380px;
    margin: 0 auto;
    padding: 0 10px;
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 14px;
    border-radius: 20px;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(117, 123, 77, 0.2);
    border: 3px solid rgba(255, 255, 255, 0.9);
    background: #e8ebd8;
  }

  .carousel-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    border: 1.5px solid var(--color-primary);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    transition: all 0.2s ease;
  }

  .carousel-btn:hover {
    background: var(--color-primary);
    color: #ffffff;
  }

  .prev-btn {
    left: 18px;
  }

  .next-btn {
    right: 18px;
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(117, 123, 77, 0.3);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .carousel-dot.active {
    background-color: var(--color-primary);
    transform: scale(1.3);
    width: 18px;
    border-radius: 10px;
  }

  .gallery-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15.5px;
    color: var(--color-primary-dark);
    margin: 18px auto 0 auto;
    max-width: 340px;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 360px) {
    .duo-img {
      height: 180px;
    }
    .carousel-img {
      height: 320px;
    }
  }
</style>

<script is:inline>
  (function() {
    var track = document.getElementById('galleryTrack');
    var prevBtn = document.getElementById('galleryPrevBtn');
    var nextBtn = document.getElementById('galleryNextBtn');
    var dots = document.querySelectorAll('#galleryDots .carousel-dot');

    if (!track) return;

    function getSlideWidth() {
      var slide = track.querySelector('.carousel-slide');
      return slide ? slide.offsetWidth + 14 : 300;
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        track.scrollBy({ left: -getSlideWidth(), behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        track.scrollBy({ left: getSlideWidth(), behavior: 'smooth' });
      });
    }

    // Actualizar puntos activos según posición de scroll
    track.addEventListener('scroll', function() {
      var slideW = getSlideWidth();
      var activeIndex = Math.round(track.scrollLeft / slideW);
      dots.forEach(function(dot, idx) {
        if (idx === activeIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }, { passive: true });

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var idx = parseInt(dot.getAttribute('data-dot') || '0', 10);
        track.scrollTo({ left: idx * getSlideWidth(), behavior: 'smooth' });
      });
    });
  })();
</script>

