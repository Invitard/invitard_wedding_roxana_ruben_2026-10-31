---
// RsvpSection.astro - Confirmación de Asistencia con Modal y WhatsApp
import { asset } from '../utils/paths';
---

<section class="inv-section rsvp-section fade-in-on-scroll">
  <!-- Tarjeta de puntualidad en verde texturizado -->
  <div class="section-green-textured punctuality-card">
    <p class="punctuality-text">
      Agradecemos de antemano su puntual llegada, ya que daremos inicio al evento a la hora programada. Ser&aacute; un honor recibirlos.
    </p>
  </div>

  <div class="rsvp-card">
    <!-- Ícono WhatsApp oficial en lugar de teléfono -->
    <div class="rsvp-icon">
      <svg width="38" height="38" viewBox="0 0 24 24" fill="#4A1221" aria-hidden="true">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </div>

    <h2 class="rsvp-title">Confirma tu Asistencia</h2>

    <p class="rsvp-instruction">
      Por favor confirma tu asistencia a trav&eacute;s de WhatsApp para acompa&ntilde;arnos en este d&iacute;a tan especial.
    </p>

    <!-- Botón que abre el modal -->
    <div class="rsvp-btn-wrapper">
      <button
        type="button"
        id="openRsvpModalBtn"
        class="inv-btn inv-btn-primary"
        aria-haspopup="dialog"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        Confirmar Asistencia
      </button>
    </div>

    <p class="rsvp-disclaimer">
      La presente invitaci&oacute;n es personal e intransferible. Agradecemos su comprensi&oacute;n y colaboraci&oacute;n para mantener una adecuada organizaci&oacute;n del evento.
    </p>

    <!-- Separador sutil -->
    <div class="gold-divider" style="margin: 22px auto 14px auto;">
      <span class="gold-divider-dot"></span>
    </div>

    <!-- Firma de los Novios -->
    <div class="rsvp-signature">
      Roxana <span class="couple-amp">&amp;</span> Ruben
    </div>
  </div>
</section>

<!-- MODAL DE CONFIRMACIÓN DE ASISTENCIA -->
<div id="rsvpModal" class="rsvp-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modalRsvpTitle" style="display: none;">
  <div class="rsvp-modal-card">
    <button type="button" id="closeRsvpModalBtn" class="modal-close-btn" aria-label="Cerrar modal">&times;</button>

    <div class="modal-header">
      <h3 id="modalRsvpTitle" class="modal-title">Confirmar Asistencia</h3>
      <span class="modal-subtitle">Boda Roxana <span class="couple-amp">&amp;</span> Ruben</span>
    </div>

    <form id="rsvpForm" class="modal-form" onsubmit="return false;">
      <!-- Campo 1: Nombre Principal -->
      <div class="form-group">
        <label for="rsvpInputName" class="form-label">Tu Nombre y Apellido <span class="req">*</span></label>
        <input
          type="text"
          id="rsvpInputName"
          class="form-input"
          placeholder="Ej. Juan Pérez"
          required
          autocomplete="name"
        />
      </div>

      <!-- Campo 2: Acompañante (solo 1 adicional) -->
      <div id="companionContainer" class="form-group companion-group" style="display: none;">
        <div class="companion-header">
          <label for="rsvpInputCompanion" class="form-label">Nombre del Acompañante</label>
          <button type="button" id="removeCompanionBtn" class="btn-text-remove" title="Quitar acompañante">
            &times; Quitar
          </button>
        </div>
        <input
          type="text"
          id="rsvpInputCompanion"
          class="form-input"
          placeholder="Ej. María Gómez"
          autocomplete="off"
        />
      </div>

      <!-- Botón para añadir acompañante (1 máx.) -->
      <div class="add-companion-wrapper">
        <button type="button" id="addCompanionBtn" class="btn-add-companion">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Añadir acompañante
        </button>
      </div>

      <!-- Botón Enviar a WhatsApp -->
      <div class="modal-submit-wrapper">
        <button type="submit" id="submitRsvpWhatsappBtn" class="btn-submit-rsvp">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          Confirmar por WhatsApp
        </button>
      </div>
    </form>
  </div>
</div>

<style>
  .rsvp-section {
    padding-top: 10px;
    padding-bottom: 25px;
  }

  .punctuality-card {
    padding: 24px 18px;
    margin-bottom: 24px;
    border-radius: 16px;
  }

  .punctuality-text {
    font-family: var(--font-serif);
    font-size: 15px;
    color: #FFFFF1;
    line-height: 1.6;
    margin: 0;
    font-weight: 500;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }

  .rsvp-card {
    background: rgba(255, 255, 255, 0.94);
    border: 1.5px solid var(--color-border);
    border-radius: 20px;
    padding: 28px 18px;
    margin: 0 auto;
    max-width: 380px;
    box-shadow: 0 6px 22px rgba(74, 18, 33, 0.12);
    text-align: center;
  }

  .rsvp-icon {
    margin-bottom: 10px;
    display: flex;
    justify-content: center;
  }

  .rsvp-title {
    font-family: var(--font-heading);
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--color-primary);
    margin: 0 0 12px 0;
    text-transform: uppercase;
  }

  .rsvp-instruction {
    font-family: var(--font-serif);
    font-size: 14.5px;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0 auto 22px auto;
    max-width: 320px;
  }

  .rsvp-btn-wrapper {
    margin-bottom: 20px;
  }

  .rsvp-disclaimer {
    font-family: var(--font-serif);
    font-size: 12px;
    color: #777777;
    line-height: 1.5;
    margin: 0 auto;
    max-width: 300px;
    font-style: italic;
  }

  .rsvp-signature {
    font-family: var(--font-script);
    font-size: 42px;
    color: var(--color-primary);
    margin-top: 6px;
    line-height: 1.1;
  }

  /* ==========================================================================
     MODAL DE ASISTENCIA
     ========================================================================== */
  .rsvp-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(40, 10, 18, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .rsvp-modal-overlay.active {
    opacity: 1;
  }

  .rsvp-modal-card {
    background: #FFFFF1;
    background-image: url('/invitard_wedding_roxana_ruben_2026-10-31/assets/wp-content/uploads/2026/05/LAURA-ROLANDO-FONDO-TEXTURA.webp');
    background-repeat: repeat;
    background-size: 300px auto;
    border: 1.5px solid rgba(74, 18, 33, 0.28);
    border-radius: 20px;
    max-width: 420px;
    width: 100%;
    padding: 26px 20px 24px 20px;
    position: relative;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
    transform: scale(0.92);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    color: #3C3C3B;
    text-align: left;
  }

  .rsvp-modal-overlay.active .rsvp-modal-card {
    transform: scale(1);
  }

  .modal-close-btn {
    position: absolute;
    top: 12px;
    right: 14px;
    background: none;
    border: none;
    font-size: 28px;
    color: var(--color-primary);
    cursor: pointer;
    line-height: 1;
    padding: 4px 8px;
    border-radius: 50%;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .modal-close-btn:hover {
    color: var(--color-primary-dark);
    transform: scale(1.15);
  }

  .modal-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .modal-title {
    font-family: var(--font-heading);
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--color-primary);
    margin: 0 0 4px 0;
    text-transform: uppercase;
    font-weight: 700;
  }

  .modal-subtitle {
    font-family: var(--font-script);
    font-size: 24px;
    color: var(--color-secondary-dark);
    display: block;
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-family: var(--font-heading);
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  .req {
    color: #c94444;
  }

  .form-input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1.5px solid rgba(74, 18, 33, 0.22);
    background: #FFFFFF;
    color: #3C3C3B;
    font-family: var(--font-body);
    font-size: 16px; /* 16px previene auto-zoom en iOS Safari */
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
  }

  .form-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(74, 18, 33, 0.15);
  }

  .companion-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .btn-text-remove {
    background: none;
    border: none;
    color: #a84242;
    font-size: 12px;
    font-family: var(--font-heading);
    letter-spacing: 1px;
    cursor: pointer;
    padding: 2px 4px;
    text-decoration: underline;
  }

  .btn-text-remove:hover {
    color: #c92a2a;
  }

  .add-companion-wrapper {
    margin-top: -4px;
  }

  .btn-add-companion {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 1.5px dashed var(--color-primary);
    color: var(--color-primary);
    border-radius: 20px;
    padding: 8px 16px;
    font-family: var(--font-heading);
    font-size: 12.5px;
    letter-spacing: 1.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
    justify-content: center;
  }

  .btn-add-companion:hover,
  .btn-add-companion:active {
    background: rgba(74, 18, 33, 0.08);
    border-color: var(--color-primary-dark);
    color: var(--color-primary-dark);
  }

  .modal-submit-wrapper {
    margin-top: 8px;
  }

  .btn-submit-rsvp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 13px 20px;
    border-radius: 30px;
    background-color: var(--color-primary);
    border: none;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(74, 18, 33, 0.35);
    transition: all 0.25s ease;
    min-height: 48px;
  }

  .btn-submit-rsvp:hover,
  .btn-submit-rsvp:active {
    background-color: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(74, 18, 33, 0.45);
  }
</style>

<script is:inline>
  (function () {
    var modal = document.getElementById('rsvpModal');
    var openBtn = document.getElementById('openRsvpModalBtn');
    var closeBtn = document.getElementById('closeRsvpModalBtn');
    var addCompBtn = document.getElementById('addCompanionBtn');
    var removeCompBtn = document.getElementById('removeCompanionBtn');
    var compContainer = document.getElementById('companionContainer');
    var nameInput = document.getElementById('rsvpInputName');
    var compInput = document.getElementById('rsvpInputCompanion');
    var form = document.getElementById('rsvpForm');

    // Número destino de WhatsApp (según DATA.md: +51 994 816 120)
    var WA_PHONE = '51994816120';

    // Rellenar automáticamente con parámetro ?invitados= si existe
    try {
      var params = new URLSearchParams(window.location.search);
      var invitadoParam = params.get('invitados') || params.get('invitado');
      if (invitadoParam && nameInput) {
        var cleanName = decodeURIComponent(invitadoParam.replace(/_/g, ' '));
        if (cleanName.toLowerCase() !== 'familia y amigos') {
          nameInput.value = cleanName;
        }
      }
    } catch (e) {}

    function openModal() {
      if (!modal) return;
      modal.style.display = 'flex';
      setTimeout(function () {
        modal.classList.add('active');
        if (nameInput) nameInput.focus();
      }, 10);
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('active');
      setTimeout(function () {
        modal.style.display = 'none';
      }, 300);
      document.body.style.overflow = '';
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    // Cerrar al hacer clic en el backdrop
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
      });
    }

    // Cerrar con Escape
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
        closeModal();
      }
    });

    // Añadir acompañante (solo 1 adicional permitido)
    if (addCompBtn && compContainer) {
      addCompBtn.addEventListener('click', function () {
        compContainer.style.display = 'flex';
        addCompBtn.style.display = 'none';
        if (compInput) compInput.focus();
      });
    }

    // Quitar acompañante
    if (removeCompBtn && compContainer && addCompBtn) {
      removeCompBtn.addEventListener('click', function () {
        compContainer.style.display = 'none';
        if (compInput) compInput.value = '';
        addCompBtn.style.display = 'inline-flex';
      });
    }

    // Enviar confirmación a WhatsApp
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();

        var nombre = nameInput ? nameInput.value.trim() : '';
        var acompanante = (compInput && compContainer && compContainer.style.display !== 'none')
          ? compInput.value.trim()
          : '';

        if (!nombre) {
          if (nameInput) {
            nameInput.focus();
            nameInput.style.borderColor = '#c94444';
          }
          return;
        }

        var cantidad = acompanante ? 2 : 1;
        var nombresAsistentes = acompanante ? (nombre + ' y ' + acompanante) : nombre;

        var mensaje = 'Buenos días Karol, confirmamos la asistencia para la boda de Roxana y Ruben en la fecha Sábado, 02 de Enero de 2027.\n\n' +
          'Cantidad de asistentes: ' + cantidad + '\n' +
          'Nombre de los asistentes: ' + nombresAsistentes;

        var waUrl = 'https://api.whatsapp.com/send?phone=' + WA_PHONE + '&text=' + encodeURIComponent(mensaje);

        window.open(waUrl, '_blank');
        closeModal();
      });
    }
  })();
</script>
