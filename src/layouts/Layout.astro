---
// Layout.astro
import '../styles/fonts.css';
import '../styles/envelope.css';
import '../styles/theme.css';
import { asset } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ROXANA & RUBEN - Nuestra Boda",
  description = "Acompaña a Roxana y Ruben en este día tan especial. Sábado, 02 de Enero de 2027."
} = Astro.props;

const faviconUrl = asset("/assets/wp-content/uploads/2026/07/ROXANA-RUBEN-INICIALES.svg");
const lottieScriptUrl = asset("/assets/wp-content/plugins/elementor-pro/assets/lib/lottie/lottie.min.js");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <meta name="theme-color" content="#4A1221" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={faviconUrl} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Aref+Ruqaa+Ink:wght@400;700&family=Cormorant+Unicase:wght@400;500;600;700&family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Lottie Web Animation Engine -->
    <script is:inline src={lottieScriptUrl}></script>
  </head>
  <body>
    <slot />

    <!-- Scroll Animation & Lottie Observer -->
    <script is:inline>
      (function () {
        function initScrollAndLottie() {
          // 1. Fade in on scroll
          var fadeEls = document.querySelectorAll('.fade-in-on-scroll');
          if ('IntersectionObserver' in window) {
            var scrollObserver = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    scrollObserver.unobserve(entry.target);
                  }
                });
              },
              { rootMargin: '0px 0px -40px 0px' }
            );

            fadeEls.forEach(function (el) {
              scrollObserver.observe(el);
            });
          } else {
            fadeEls.forEach(function (el) {
              el.classList.add('is-visible');
            });
          }

          // 2. Lottie Animations
          if (typeof lottie !== 'undefined') {
            var lottieContainers = document.querySelectorAll('.lottie-container');
            lottieContainers.forEach(function (container) {
              var animUrl = container.getAttribute('data-anim');
              var inner = container.querySelector('.lottie-inner');
              if (animUrl && inner && inner.children.length === 0) {
                try {
                  lottie.loadAnimation({
                    container: inner,
                    renderer: 'svg',
                    loop: true,
                    autoplay: true,
                    path: animUrl
                  });
                } catch (err) {
                  console.warn('Error inicializando Lottie:', err);
                }
              }
            });
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initScrollAndLottie);
        } else {
          initScrollAndLottie();
        }

        window.addEventListener('load', function () {
          setTimeout(initScrollAndLottie, 200);
        });
      })();
    </script>
  </body>
</html>
