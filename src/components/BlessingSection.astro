---
// BlessingSection.astro - Padres y Padrinos
---

<section class="inv-section blessing-section fade-in-on-scroll">
  <!-- Título Padres -->
  <div class="cortejo-header">
    <h2 class="title-cortejo">Con la bendici&oacute;n de Dios y de nuestros padres</h2>
  </div>

  <!-- Lista Padres -->
  <div class="cortejo-grid">
    <div class="cortejo-card">
      <span class="cortejo-role">Padres de la Novia</span>
      <p class="cortejo-name">Leonardo Mamani Ticona</p>
      <p class="cortejo-name">Marcia Mamani Ticona</p>
    </div>

    <div class="cortejo-card">
      <span class="cortejo-role">Padres del Novio</span>
      <p class="cortejo-name">Ra&uacute;l Huaman &Aacute;lvarez</p>
      <p class="cortejo-name">Sonia Santos Quiroz</p>
    </div>
  </div>

  <!-- Separador intermedio -->
  <div class="gold-divider">
    <span class="gold-divider-dot"></span>
  </div>

  <!-- Título Padrinos -->
  <div class="cortejo-header">
    <h2 class="title-cortejo">Con la gu&iacute;a de nuestros padrinos</h2>
  </div>

  <!-- Lista Padrinos -->
  <div class="cortejo-grid">
    <div class="cortejo-card">
      <span class="cortejo-role">Padrinos de Religioso</span>
      <p class="cortejo-name">Roy Ad&aacute;n Mercado Flores</p>
      <p class="cortejo-name">Ana Cecilia Tolentino Crist&oacute;bal</p>
    </div>

    <div class="cortejo-card">
      <span class="cortejo-role">Padrinos de Civil</span>
      <p class="cortejo-name">Ernesto Valencia Mamani</p>
      <p class="cortejo-name">Juana Chambi Condori</p>
    </div>
  </div>
</section>

<style>
  .blessing-section {
    padding-top: 15px;
    padding-bottom: 25px;
  }

  .cortejo-header {
    margin-bottom: 15px;
  }

  .title-cortejo {
    font-family: var(--font-cortejo);
    font-size: 16.5px;
    letter-spacing: 1.8px;
    color: var(--color-gold);
    text-transform: uppercase;
    font-weight: bold;
    margin: 0 auto;
    max-width: 380px;
    line-height: 1.4;
  }

  .cortejo-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 15px auto;
    max-width: 400px;
  }

  .cortejo-card {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(129, 128, 76, 0.2);
    border-radius: 12px;
    padding: 14px 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  .cortejo-role {
    display: block;
    font-family: var(--font-cortejo);
    font-size: 12.5px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .cortejo-name {
    font-family: var(--font-serif);
    font-size: 16px;
    margin: 3px 0;
    color: var(--color-text-main);
    font-weight: 500;
  }

  @media (min-width: 420px) {
    .title-cortejo {
      font-size: 18px;
    }
  }
</style>

