---
// BlessingSection.astro - Padres y Padrinos en 2 Columnas Estilizadas
import { asset } from '../utils/paths';
---

<section class="inv-section blessing-section fade-in-on-scroll">
  <!-- Título Padres en Tipografía Cursiva Estilizada -->
  <div class="cortejo-header">
    <h2 class="cortejo-script-title">Junto con nuestros padres:</h2>
  </div>

  <!-- Nombres de los Padres en 2 Columnas -->
  <div class="parents-columns-grid">
    <!-- Columna Izquierda: Sonia y Raúl -->
    <div class="parents-column">
      <p class="parent-script-name">Ra&uacute;l Huaman &Aacute;lvarez</p>
      <p class="parent-script-name">Sonia Santos Quiroz</p>
    </div>

    <!-- Columna Derecha: Leonardo y Marcia -->
    <div class="parents-column">
      <p class="parent-script-name">Leonardo Mamani Ticona</p>
      <p class="parent-script-name">Marcia Mamani Ticona</p>
    </div>
  </div>

  <!-- Separador floral decorador entre Padres y Padrinos -->
  <div class="blessing-floral-divider" aria-hidden="true">
    <span class="blessing-divider-line"></span>
    <img
      src={asset("/img/flowers_002.png")}
      alt=""
      width="58"
      height="78"
      class="blessing-flower-icon"
      loading="lazy"
    />
    <span class="blessing-divider-line"></span>
  </div>

  <!-- Título Padrinos en Tipografía Cursiva Estilizada -->
  <div class="cortejo-header">
    <h2 class="cortejo-script-title">Y con la gu&iacute;a de nuestros padrinos:</h2>
  </div>

  <!-- Nombres de los Padrinos en 2 Columnas -->
  <div class="parents-columns-grid">
    <!-- Columna Izquierda: Padrinos Religioso -->
    <div class="parents-column">
      <span class="padrinos-badge">Religioso</span>
      <p class="parent-script-name">Roy Ad&aacute;n Mercado Flores</p>
      <p class="parent-script-name">Ana Cecilia Tolentino Crist&oacute;bal</p>
    </div>

    <!-- Columna Derecha: Padrinos Civil -->
    <div class="parents-column">
      <span class="padrinos-badge">Civil</span>
      <p class="parent-script-name">Ernesto Valencia Mamani</p>
      <p class="parent-script-name">Juana Chambi Condori</p>
    </div>
  </div>
</section>

<style>
  .blessing-section {
    padding-top: 15px;
    padding-bottom: 25px;
  }

  .blessing-floral-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 22px auto 18px auto;
    max-width: 280px;
    width: 80%;
  }

  .blessing-divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(74, 18, 33, 0.25), transparent);
  }

  .blessing-flower-icon {
    width: 50px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(74, 18, 33, 0.15));
    opacity: 0.94;
  }

  .cortejo-header {
    margin-bottom: 12px;
  }

  .cortejo-script-title {
    font-family: var(--font-script);
    font-size: 28px;
    color: var(--color-primary);
    margin: 0 auto;
    line-height: 1.25;
    font-weight: normal;
    text-shadow: 0 1px 3px rgba(74, 18, 33, 0.15);
  }

  /* Distribución en 2 columnas estilo invitación clásica */
  .parents-columns-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 20px;
    margin: 16px auto;
    max-width: 440px;
    align-items: start;
    padding: 0 8px;
  }

  .parents-column {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .parent-script-name {
    font-family: var(--font-serif);
    font-size: 15.5px;
    line-height: 1.45;
    margin: 4px 0;
    color: #3C3C3B;
    font-weight: 500;
    letter-spacing: 0.2px;
    word-break: normal;
  }

  .padrinos-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-secondary-dark);
    background: rgba(142, 148, 98, 0.14);
    border: 1px solid rgba(142, 148, 98, 0.32);
    padding: 2px 10px;
    border-radius: 12px;
    margin-bottom: 6px;
    font-weight: 700;
  }

  @media (max-width: 360px) {
    .parent-script-name {
      font-size: 14px;
    }
    .parents-columns-grid {
      gap: 12px 10px;
    }
  }

  @media (min-width: 440px) {
    .parent-script-name {
      font-size: 16.5px;
    }
  }
</style>
