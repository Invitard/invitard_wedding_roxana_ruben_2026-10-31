---
// index.astro - Invitación de Boda Roxana & Ruben
import Layout from '../layouts/Layout.astro';
import EnvelopeIntro from '../components/EnvelopeIntro.astro';
import IntroPhotosSection from '../components/IntroPhotosSection.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import HeroSection from '../components/HeroSection.astro';
import BlessingSection from '../components/BlessingSection.astro';
import CountdownSection from '../components/CountdownSection.astro';
import GuestPassSection from '../components/GuestPassSection.astro';
import LocationsSection from '../components/LocationsSection.astro';
import DetailsSection from '../components/DetailsSection.astro';
import PhotoGallerySection from '../components/PhotoGallerySection.astro';
import GiftBankSection from '../components/GiftBankSection.astro';
import RsvpSection from '../components/RsvpSection.astro';
import FooterSection from '../components/FooterSection.astro';
---

<Layout>
  <!-- Sobre 3D Interactivo -->
  <EnvelopeIntro />

  <!-- Contenido Principal de la Invitación (Mobile First) -->
  <main class="invitacion-real" id="invitacionMain">
    <!-- Carrusel de 3 Fotos a Pantalla Completa (100vw x 100vh) fuera de la columna -->
    <IntroPhotosSection />

    <!-- Columna Central de la Invitación -->
    <div class="invitation-container" id="invitationContent">
      <HeroSection />
      
      <!-- Tira decorativa floral -->
      <div class="ribbon-deco" aria-hidden="true"></div>

      <BlessingSection />

      <!-- Tira decorativa floral -->
      <div class="ribbon-dd" aria-hidden="true"></div>

      <!-- Sección Verde Olivo Texturizada: Cuenta Regresiva -->
      <CountdownSection />

      <!-- Tira decorativa floral -->
      <div class="ribbon-deco" aria-hidden="true"></div>

      <GuestPassSection />

      <!-- Tira decorativa floral -->
      <div class="ribbon-dd" aria-hidden="true"></div>

      <!-- Sección Verde Olivo Texturizada: Ubicaciones con Arco Arquitectónico -->
      <LocationsSection />

      <!-- Tira decorativa floral -->
      <div class="ribbon-deco" aria-hidden="true"></div>

      <DetailsSection />

      <!-- Tira decorativa floral -->
      <div class="ribbon-dd" aria-hidden="true"></div>

      <!-- Galería de Fotos y Carrusel de Recuerdos -->
      <PhotoGallerySection />

      <!-- Tira decorativa floral -->
      <div class="ribbon-deco" aria-hidden="true"></div>

      <!-- Sección Verde Olivo Texturizada: Donaciones y Datos Bancarios -->
      <GiftBankSection />

      <!-- Tira decorativa floral -->
      <div class="ribbon-deco" aria-hidden="true"></div>

      <!-- Confirmación WhatsApp y Cierre -->
      <RsvpSection />

      <!-- Footer Promocional / Contacto Eventos -->
      <FooterSection />
    </div>
  </main>

  <!-- Reproductor Flotante de Música -->
  <MusicPlayer />
</Layout>

<style>
  /* Refuerzo para visualización de la invitación */
  .invitacion-real.activa {
    visibility: visible !important;
    opacity: 1 !important;
    height: auto !important;
    overflow: visible !important;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var cta = document.getElementById('btn-cta');
    var main = document.getElementById('invitacionMain');
    if (cta && main) {
      cta.addEventListener('click', function () {
        main.classList.add('activa');
      });
    }
  });
</script>
