---
// HeroSection.astro
import { asset } from '../utils/paths';
---

<section class="inv-section hero-section fade-in-on-scroll" id="heroSection">
  <!-- Decoradores florales en las esquinas superiores de la tarjeta -->
  <div class="card-floral-corner corner-top-left" aria-hidden="true">
    <img
      src={asset("/img/flowers_001.png")}
      alt=""
      width="75"
      height="100"
      class="corner-flower-img"
      loading="eager"
    />
  </div>
  <div class="card-floral-corner corner-top-right" aria-hidden="true">
    <img
      src={asset("/img/flowers_002.png")}
      alt=""
      width="80"
      height="107"
      class="corner-flower-img"
      loading="eager"
    />
  </div>

  <!-- Monograma de Iniciales R & R (Texto con tipografía estilizada Bickham Script) -->
  <div class="monogram-wrapper">
    <span class="monogram-text">R &amp; R</span>
  </div>

  <!-- Adorno Floral flowers_001.png -->
  <div class="ornament-wrapper">
    <img
      src={asset("/img/flowers_001.png")}
      alt="Arreglo Floral"
      width="100"
      height="135"
      class="ornament-floral-img"
    />
  </div>

  <!-- Versículo Bíblico -->
  <blockquote class="verse-text">
    &ldquo;Tres cosas durar&aacute;n para siempre: la fe, la esperanza y el amor; y la mayor de las tres es el amor.&rdquo;
    <footer class="verse-reference">1 Corintios 13:13</footer>
  </blockquote>

  <!-- Separador dorado -->
  <div class="gold-divider">
    <span class="gold-divider-dot"></span>
  </div>

  <!-- Encabezado Principal -->
  <div class="titles-group">
    <span class="sub-heading">¡NOS CASAMOS!</span>

    <!-- Fotografía Principal de los Novios -->
    <div class="hero-photo-frame">
      <img
        src={asset("/img/DSC_4538.jpg")}
        alt="Roxana y Ruben"
        class="hero-photo"
        loading="eager"
      />
    </div>

    <h1 class="main-couple-names">Roxana &amp; Ruben</h1>
    <p class="couple-dedication">
      Hoy comenzamos juntos el camino m&aacute;s importante de nuestras vidas.
    </p>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: 24px;
    padding-bottom: 20px;
    overflow: visible;
  }

  /* Decoradores florales de esquinas de la tarjeta */
  .card-floral-corner {
    position: absolute;
    top: -6px;
    z-index: 2;
    pointer-events: none;
    user-select: none;
  }

  .card-floral-corner.corner-top-left {
    left: -10px;
    transform: rotate(-12deg);
  }

  .card-floral-corner.corner-top-right {
    right: -12px;
    transform: rotate(10deg);
  }

  .corner-flower-img {
    width: 68px;
    height: auto;
    max-height: 96px;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgba(74, 18, 33, 0.18));
    opacity: 0.92;
  }

  @media (max-width: 380px) {
    .corner-flower-img {
      width: 56px;
    }
  }

  .monogram-wrapper {
    margin: 5px auto 10px auto;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  .monogram-text {
    font-family: var(--font-script);
    font-size: 84px;
    line-height: 1.15;
    color: var(--color-primary);
    display: inline-block;
    padding: 10px 24px 15px 24px;
    letter-spacing: 4px;
    font-weight: normal;
    user-select: none;
    -webkit-user-select: none;
    text-shadow: 0 2px 6px rgba(74, 18, 33, 0.2);
  }

  .ornament-wrapper {
    margin: 4px auto 14px auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ornament-floral-img {
    width: 95px;
    height: auto;
    max-height: 125px;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgba(74, 18, 33, 0.16));
    opacity: 0.96;
    transition: transform 0.3s ease;
  }

  .verse-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.7;
    color: #575756;
    max-width: 380px;
    margin: 0 auto;
    padding: 0 10px;
  }

  .verse-reference {
    margin-top: 6px;
    font-size: 13.5px;
    color: var(--color-primary);
    font-style: normal;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .titles-group {
    margin-top: 15px;
  }

  .sub-heading {
    display: block;
    font-family: var(--font-heading);
    font-size: 16px;
    letter-spacing: 3.5px;
    color: var(--color-primary);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .hero-photo-frame {
    margin: 16px auto 14px auto;
    max-width: 330px;
    width: 86%;
    border-radius: 170px 170px 24px 24px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(74, 18, 33, 0.18);
    border: 3px solid rgba(255, 255, 255, 0.9);
    background: #f7f4ee;
  }

  .hero-photo {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }



  .main-couple-names {
    font-family: var(--font-script);
    font-size: 58px;
    color: var(--color-primary);
    margin: 0 0 10px 0;
    line-height: 1.15;
    font-weight: normal;
    text-shadow: 0 2px 8px rgba(74, 18, 33, 0.18);
  }

  .couple-dedication {
    font-family: var(--font-serif);
    font-size: 15px;
    color: #575756;
    max-width: 340px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (min-width: 480px) {
    .monogram-text {
      font-size: 96px;
    }
    .main-couple-names {
      font-size: 68px;
    }
  }
</style>
