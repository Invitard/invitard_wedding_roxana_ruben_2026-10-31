---
// PhotoGallerySection.astro - Carrusel de Recuerdos "Nuestra Historia"
import { asset } from '../utils/paths';

const galleryItems = [
  { src: asset("/img/DSC_4538.jpg"), alt: "Roxana & Ruben - Recuerdos 1" },
  { src: asset("/img/DSC_4580.jpg"), alt: "Roxana & Ruben - Recuerdos 2" },
  { src: asset("/img/DSC_4590.jpg"), alt: "Roxana & Ruben - Recuerdos 3" },
  { src: asset("/img/DSC_4630.jpg"), alt: "Roxana & Ruben - Recuerdos 4" },
  { src: asset("/img/DSC_4646.jpg"), alt: "Roxana & Ruben - Recuerdos 5" },
  { src: asset("/img/DSC_4741.jpg"), alt: "Roxana & Ruben - Recuerdos 6" },
  { src: asset("/img/DSC_4775.jpg"), alt: "Roxana & Ruben - Recuerdos 7" },
  { src: asset("/img/DSC_4779.jpg"), alt: "Roxana & Ruben - Recuerdos 8" },
  { src: asset("/img/JC7_0460.jpg"), alt: "Roxana & Ruben - Recuerdos 9" },
  { src: asset("/img/JC7_0468.jpg"), alt: "Roxana & Ruben - Recuerdos 10" },
  { src: asset("/img/JC7_0509.jpg"), alt: "Roxana & Ruben - Recuerdos 11" },
];
---

<section class="inv-section photo-gallery-section fade-in-on-scroll">
  <!-- Título del Carrusel / Galería -->
  <div class="gallery-header">
    <span class="gallery-sub">NUESTRA HISTORIA</span>
    <h2 class="gallery-title">Galer&iacute;a de Fotos</h2>
  </div>

  <!-- Carrusel Touch / Mobile First -->
  <div class="carousel-container">
    <button class="carousel-btn prev-btn" id="galleryPrevBtn" aria-label="Foto anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="carousel-track" id="galleryTrack">
      {galleryItems.map((item, index) => (
        <div class="carousel-slide" data-index={index}>
          <img
            src={item.src}
            alt={item.alt}
            class="carousel-img"
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <button class="carousel-btn next-btn" id="galleryNextBtn" aria-label="Siguiente foto">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- Contador elegante de fotos -->
  <div class="carousel-counter" id="galleryCounterDisplay">
    <span id="galleryCurrentIdx">1</span> / {galleryItems.length}
  </div>

  <!-- Indicadores de puntos -->
  <div class="carousel-dots" id="galleryDots">
    {galleryItems.map((_, index) => (
      <span class={`carousel-dot ${index === 0 ? 'active' : ''}`} data-dot={index}></span>
    ))}
  </div>

  <p class="gallery-quote">
    &ldquo;Gracias por convertir los d&iacute;as comunes en recuerdos que quiero guardar para siempre.&rdquo;
  </p>
</section>

<style>
  .photo-gallery-section {
    padding-top: 15px;
    padding-bottom: 25px;
  }

  .gallery-header {
    margin-bottom: 18px;
    text-align: center;
  }

  .gallery-sub {
    display: block;
    font-family: var(--font-heading);
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--color-primary);
    font-weight: 700;
  }

  .gallery-title {
    font-family: var(--font-script);
    font-size: 44px;
    color: var(--color-primary);
    margin: 4px 0 0 0;
    line-height: 1.2;
    font-weight: normal;
  }

  /* Carousel */
  .carousel-container {
    position: relative;
    max-width: 350px;
    margin: 0 auto;
    padding: 0 10px;
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 14px;
    border-radius: 24px;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(117, 123, 77, 0.22);
    border: 3px solid rgba(255, 255, 255, 0.92);
    background: #e8ebd8;
  }

  .carousel-img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.88);
    border: 1.5px solid var(--color-primary);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    transition: all 0.2s ease;
  }

  .carousel-btn:hover {
    background: var(--color-primary);
    color: #ffffff;
  }

  .prev-btn {
    left: 18px;
  }

  .next-btn {
    right: 18px;
  }

  .carousel-counter {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: 2px;
    text-align: center;
    margin-top: 12px;
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    padding: 0 10px;
    flex-wrap: wrap;
    max-width: 320px;
    margin-left: auto;
    margin-right: auto;
  }

  .carousel-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: rgba(117, 123, 77, 0.3);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .carousel-dot.active {
    background-color: var(--color-primary);
    transform: scale(1.2);
    width: 14px;
    border-radius: 6px;
  }

  .gallery-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15.5px;
    color: var(--color-primary-dark);
    margin: 18px auto 0 auto;
    max-width: 340px;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 360px) {
    .carousel-img {
      height: 420px;
    }
  }
</style>

<script is:inline>
  (function() {
    var track = document.getElementById('galleryTrack');
    var prevBtn = document.getElementById('galleryPrevBtn');
    var nextBtn = document.getElementById('galleryNextBtn');
    var dots = document.querySelectorAll('#galleryDots .carousel-dot');
    var counterEl = document.getElementById('galleryCurrentIdx');
    var container = track ? track.closest('.carousel-container') : null;

    if (!track) return;

    var slides = track.querySelectorAll('.carousel-slide');
    var totalSlides = slides.length;
    var autoPlayTimer = null;

    function getSlideWidth() {
      var slide = track.querySelector('.carousel-slide');
      return slide ? slide.offsetWidth + 14 : 320;
    }

    function goToSlide(index) {
      var slideW = getSlideWidth();
      var targetIndex = (index + totalSlides) % totalSlides;
      track.scrollTo({ left: targetIndex * slideW, behavior: 'smooth' });
    }

    function nextSlide() {
      var slideW = getSlideWidth();
      var activeIndex = Math.round(track.scrollLeft / slideW);
      var nextIndex = (activeIndex + 1) % totalSlides;
      track.scrollTo({ left: nextIndex * slideW, behavior: 'smooth' });
    }

    function prevSlide() {
      var slideW = getSlideWidth();
      var activeIndex = Math.round(track.scrollLeft / slideW);
      var targetIndex = (activeIndex - 1 + totalSlides) % totalSlides;
      track.scrollTo({ left: targetIndex * slideW, behavior: 'smooth' });
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    // Iniciar cambio automático cada 5 segundos
    startAutoPlay();

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        prevSlide();
        startAutoPlay();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        nextSlide();
        startAutoPlay();
      });
    }

    // Actualizar puntos y contador según posición de scroll
    track.addEventListener('scroll', function() {
      var slideW = getSlideWidth();
      var activeIndex = Math.round(track.scrollLeft / slideW);
      if (activeIndex < 0) activeIndex = 0;
      if (activeIndex >= totalSlides) activeIndex = totalSlides - 1;

      if (counterEl) {
        counterEl.textContent = activeIndex + 1;
      }

      dots.forEach(function(dot, idx) {
        if (idx === activeIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }, { passive: true });

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var idx = parseInt(dot.getAttribute('data-dot') || '0', 10);
        goToSlide(idx);
        startAutoPlay();
      });
    });

    // Pausar al interactuar táctilmente y reiniciar al soltar
    track.addEventListener('touchstart', function() {
      stopAutoPlay();
    }, { passive: true });

    track.addEventListener('touchend', function() {
      startAutoPlay();
    }, { passive: true });

    if (container) {
      container.addEventListener('mouseenter', stopAutoPlay);
      container.addEventListener('mouseleave', startAutoPlay);
    }
  })();
</script>
