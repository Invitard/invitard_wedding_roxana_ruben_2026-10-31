---
// HeroSection.astro
import { asset } from '../utils/paths';
---

<section class="inv-section hero-section fade-in-on-scroll" id="heroSection">
  <!-- Monograma de Iniciales R & R (Texto con tipografía estilizada Bickham Script) -->
  <div class="monogram-wrapper">
    <span class="monogram-text">R &amp; R</span>
  </div>

  <!-- Adorno superior -->
  <div class="ornament-wrapper">
    <img
      src={asset("/assets/wp-content/uploads/2026/07/MICHELLE-MARCO-DECCC.webp")}
      alt="Ornamento Floral"
      width="160"
      height="44"
      class="ornament-img"
    />
  </div>

  <!-- Versículo Bíblico -->
  <blockquote class="verse-text">
    &ldquo;Tres cosas durar&aacute;n para siempre: la fe, la esperanza y el amor; y la mayor de las tres es el amor.&rdquo;
    <footer class="verse-reference">1 Corintios 13:13</footer>
  </blockquote>

  <!-- Separador dorado -->
  <div class="gold-divider">
    <span class="gold-divider-dot"></span>
  </div>

  <!-- Encabezado Principal -->
  <div class="titles-group">
    <span class="sub-heading">¡NOS CASAMOS!</span>
    <h1 class="main-couple-names">Roxana &amp; Ruben</h1>
    <p class="couple-dedication">
      Hoy comenzamos juntos el camino m&aacute;s importante de nuestras vidas.
    </p>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .monogram-wrapper {
    margin: 5px auto 10px auto;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  .monogram-text {
    font-family: var(--font-script);
    font-size: 84px;
    line-height: 1.15;
    color: var(--color-primary);
    display: inline-block;
    padding: 10px 24px 15px 24px;
    letter-spacing: 4px;
    font-weight: normal;
    user-select: none;
    -webkit-user-select: none;
    text-shadow: 0 2px 6px rgba(117, 123, 77, 0.25);
  }

  .ornament-wrapper {
    margin: 6px auto 16px auto;
    display: flex;
    justify-content: center;
  }

  .ornament-img {
    width: 140px;
    height: auto;
    opacity: 0.95;
  }

  .verse-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.7;
    color: #575756;
    max-width: 380px;
    margin: 0 auto;
    padding: 0 10px;
  }

  .verse-reference {
    margin-top: 6px;
    font-size: 13.5px;
    color: var(--color-primary);
    font-style: normal;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .titles-group {
    margin-top: 15px;
  }

  .sub-heading {
    display: block;
    font-family: var(--font-heading);
    font-size: 16px;
    letter-spacing: 3.5px;
    color: var(--color-primary);
    font-weight: 700;
    margin-bottom: 8px;
  }



  .main-couple-names {
    font-family: var(--font-script);
    font-size: 58px;
    color: var(--color-primary);
    margin: 0 0 10px 0;
    line-height: 1.15;
    font-weight: normal;
    text-shadow: 0 2px 8px rgba(117, 123, 77, 0.2);
  }

  .couple-dedication {
    font-family: var(--font-serif);
    font-size: 15px;
    color: #575756;
    max-width: 340px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (min-width: 480px) {
    .monogram-text {
      font-size: 96px;
    }
    .main-couple-names {
      font-size: 68px;
    }
  }
</style>
