---
// PhotoFeaturedSection.astro - Fotografía Intermedia Destacada
import { asset } from '../utils/paths';
---

<section class="inv-section photo-featured-section fade-in-on-scroll">
  <div class="photo-featured-frame">
    <img
      src={asset("/img/gabriel-tovar-RmIxQ05GzH0-unsplash.jpg")}
      alt="Roxana y Ruben"
      class="photo-featured-img"
      loading="lazy"
    />
  </div>
  <p class="photo-featured-quote">
    &ldquo;Junto a ti, el camino es m&aacute;s bonito.&rdquo;
  </p>
</section>

<style>
  .photo-featured-section {
    padding-top: 10px;
    padding-bottom: 20px;
  }

  .photo-featured-frame {
    margin: 0 auto;
    max-width: 340px;
    width: 88%;
    border-radius: 170px 170px 24px 24px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(117, 123, 77, 0.22);
    border: 3px solid rgba(255, 255, 255, 0.9);
    background: #e8ebd8;
  }

  .photo-featured-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
  }

  .photo-featured-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    color: var(--color-primary-dark);
    margin: 18px auto 0 auto;
    max-width: 320px;
    line-height: 1.5;
  }

  @media (max-width: 360px) {
    .photo-featured-img {
      height: 350px;
    }
  }
</style>

