---
// RsvpSection.astro - Confirmación de Asistencia WhatsApp y Cierre
import { asset } from '../utils/paths';
---

<section class="inv-section rsvp-section fade-in-on-scroll">
  <!-- Tarjeta de puntualidad en verde texturizado como en el diseño original -->
  <div class="section-green-textured punctuality-card">
    <p class="punctuality-text">
      Agradecemos de antemano su puntual llegada, ya que daremos inicio al evento a la hora programada. Ser&aacute; un honor recibirlos.
    </p>
  </div>

  <div class="rsvp-card">
    <!-- Ícono WhatsApp / Confirmación -->
    <div class="rsvp-icon">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#757B4D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
    </div>

    <h2 class="rsvp-title">Confirma tu Asistencia</h2>

    <p class="rsvp-instruction">
      Por favor confirma tu asistencia a trav&eacute;s de WhatsApp para acompa&ntilde;arnos en este d&iacute;a tan especial.
    </p>

    <!-- Botón WhatsApp -->
    <div class="rsvp-btn-wrapper">
      <a
        href="https://api.whatsapp.com/send?phone=51950375573&text=%C2%A1Hola!%20Confirmo%20mi%20asistencia%20a%20la%20boda%20de%20Roxana%20y%20Ruben."
        target="_blank"
        rel="noopener noreferrer"
        class="inv-btn inv-btn-primary"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        Confirmar Asistencia
      </a>
    </div>

    <p class="rsvp-disclaimer">
      La presente invitaci&oacute;n es personal e intransferible. Agradecemos su comprensi&oacute;n y colaboraci&oacute;n para mantener una adecuada organizaci&oacute;n del evento.
    </p>

    <!-- Separador sutil -->
    <div class="gold-divider" style="margin: 22px auto 14px auto;">
      <span class="gold-divider-dot"></span>
    </div>

    <!-- Firma de los Novios -->
    <div class="rsvp-signature">
      Roxana &amp; Ruben
    </div>
  </div>
</section>

<style>
  .rsvp-section {
    padding-top: 10px;
    padding-bottom: 25px;
  }

  .punctuality-card {
    padding: 24px 18px;
    margin-bottom: 24px;
    border-radius: 16px;
  }

  .punctuality-text {
    font-family: var(--font-serif);
    font-size: 15px;
    color: #FFFFF1;
    line-height: 1.6;
    margin: 0;
    font-weight: 500;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }

  .rsvp-card {
    background: rgba(255, 255, 255, 0.92);
    border: 1.5px solid rgba(117, 123, 77, 0.3);
    border-radius: 20px;
    padding: 28px 18px;
    margin: 0 auto;
    max-width: 380px;
    box-shadow: 0 4px 20px rgba(117, 123, 77, 0.1);
    text-align: center;
  }

  .rsvp-icon {
    margin-bottom: 8px;
  }

  .rsvp-title {
    font-family: var(--font-heading);
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--color-primary);
    margin: 0 0 12px 0;
    text-transform: uppercase;
  }

  .rsvp-instruction {
    font-family: var(--font-serif);
    font-size: 14.5px;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0 auto 22px auto;
    max-width: 320px;
  }

  .rsvp-btn-wrapper {
    margin-bottom: 20px;
  }

  .rsvp-disclaimer {
    font-family: var(--font-serif);
    font-size: 12px;
    color: #777777;
    line-height: 1.5;
    margin: 0 auto;
    max-width: 300px;
    font-style: italic;
  }

  .rsvp-signature {
    font-family: var(--font-script);
    font-size: 42px;
    color: var(--color-primary);
    margin-top: 6px;
    line-height: 1.1;
  }
</style>
