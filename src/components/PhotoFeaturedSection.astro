---
// PhotoFeaturedSection.astro - Fotografía Intermedia Destacada
import { asset } from '../utils/paths';
---

<section class="inv-section photo-featured-section fade-in-on-scroll">
  <div class="photo-featured-wrapper">
    <!-- Decorador floral superior -->
    <div class="photo-corner-floral" aria-hidden="true">
      <img
        src={asset("/img/flowers_001.png")}
        alt=""
        width="65"
        height="88"
        class="photo-flower-accent"
        loading="lazy"
      />
    </div>

    <div class="photo-featured-frame">
      <img
        src={asset("/img/DSC_4775.jpg")}
        alt="Roxana y Ruben"
        class="photo-featured-img"
        loading="lazy"
      />
    </div>
  </div>
  <p class="photo-featured-quote">
    &ldquo;Junto a ti, el camino es m&aacute;s bonito.&rdquo;
  </p>
</section>

<style>
  .photo-featured-section {
    padding-top: 10px;
    padding-bottom: 20px;
  }

  .photo-featured-wrapper {
    position: relative;
    max-width: 340px;
    width: 88%;
    margin: 0 auto;
  }

  .photo-corner-floral {
    position: absolute;
    top: -10px;
    right: -8px;
    z-index: 3;
    pointer-events: none;
  }

  .photo-flower-accent {
    width: 58px;
    height: auto;
    filter: drop-shadow(0 3px 8px rgba(74, 18, 33, 0.22));
    transform: rotate(18deg);
  }

  .photo-featured-frame {
    margin: 0 auto;
    width: 100%;
    border-radius: 170px 170px 24px 24px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(74, 18, 33, 0.18);
    border: 3px solid rgba(255, 255, 255, 0.9);
    background: #f7f4ee;
  }

  .photo-featured-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
  }

  .photo-featured-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    color: var(--color-primary-dark);
    margin: 18px auto 0 auto;
    max-width: 320px;
    line-height: 1.5;
  }

  @media (max-width: 360px) {
    .photo-featured-img {
      height: 350px;
    }
  }
</style>

